  },
  {
    "name": "search_tasks",
    "description": "Search tasks by title within a workspace. Performs case-insensitive substring matching. Optionally filter by projectId and status. Returns up to `limit` results (default 100).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspaceSlug": {
          "description": "The workspace slug",
          "type": "string"
        },
        "query": {
          "description": "Search term to match against task titles",
          "type": "string"
        },
        "projectId": {
          "description": "Filter to tasks in this project",
          "type": "string"
        },
        "status": {
          "description": "Filter tasks by status",
          "type": "string",
          "enum": ["TODO", "IN_PROGRESS", "IN_REVIEW", "DONE", "CANCELLED"]
        },
        "limit": {
          "description": "Maximum number of results to return (default 100)",
          "type": "number"
        }
      },
      "required": ["workspaceSlug", "query"],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
