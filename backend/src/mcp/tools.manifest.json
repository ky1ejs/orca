  {
    "name": "search_initiatives",
    "description": "Search initiatives by name within a workspace. Performs case-insensitive substring matching.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspaceSlug": {
          "description": "The workspace slug",
          "type": "string"
        },
        "query": {
          "description": "Search term to match against initiative names",
          "type": "string"
        }
      },
      "required": ["workspaceSlug", "query"],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "search_projects",
    "description": "Search projects by name within a workspace. Performs case-insensitive substring matching.",
