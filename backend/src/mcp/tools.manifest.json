    }
  },
  {
    "name": "link_tasks",
    "description": "Create a relationship (link) between two tasks.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sourceTaskId": {
          "description": "The source task UUID",
          "type": "string"
        },
        "targetTaskId": {
          "description": "The target task UUID",
          "type": "string"
        },
        "type": {
          "description": "Relationship type: BLOCKS (source blocks target), RELATES_TO (bidirectional), DUPLICATES (source duplicates target)",
          "type": "string",
          "enum": ["BLOCKS", "RELATES_TO", "DUPLICATES"]
        }
      },
      "required": ["sourceTaskId", "targetTaskId", "type"],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
