#!/usr/bin/env bash
#
# Bootstrap the web (Electron) package.
# Called by the repo-level scripts/bootstrap after environment is set up.
#
# Expects:
#   - CWD is the worktree root (or repo root)
#
# Note: web/.env (with VITE_BACKEND_URL + VITE_AUTH_TOKEN) is written
# afterwards by `(cd backend && bun run dev-bootstrap)`, which needs Prisma
# to be generated first — so this script just installs deps and runs setup.

set -euo pipefail

cd "$(dirname "$0")/.."

echo "Installing dependencies..."
bun install 2>&1

echo "Running web setup (codegen + native modules)..."
bun run setup 2>&1

echo "Web bootstrap complete."
